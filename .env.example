# ---------------------------------------------------------------------------
# Academy Platform — environment template
# Copy to `apps/api/.env` for the API, and to `apps/web/.env.local` for the web
# app. The API file must live in `apps/api/` because the Prisma CLI resolves
# `.env` relative to the schema; a repo-root `.env` is also read at runtime but
# Prisma commands will not see it. NEVER commit a real `.env` file.
# ---------------------------------------------------------------------------

# === Runtime ===============================================================
NODE_ENV=development
API_PORT=4000
# Public origin of the API itself (used to build OAuth callback URLs).
API_PUBLIC_URL=http://localhost:4000
# Public origin of the Next.js web app (used for redirects + email links).
WEB_PUBLIC_URL=http://localhost:3000
# Comma-separated list of browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000
# How many proxies sit in front of the API. 0 when it is exposed directly, 1
# behind a single load balancer (Fly, Render, Nginx), 2 when the web app also
# proxies the browser's API calls through its own origin. Rate limits key on the
# address this resolves to, so an inexact count breaks them in one direction or
# the other.
TRUST_PROXY=0

# === Database ==============================================================
# PostgreSQL connection string. Supabase example:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/academy?schema=public
# Direct (non-pooled) connection. Prisma requires a value here — an empty
# variable is treated as missing and the schema will not load.
#   * Direct connection: set this to the same value as DATABASE_URL.
#   * Behind a pooler (Supabase pgbouncer, Neon): set DATABASE_URL to the pooled
#     URL and this to the direct one, so migrations bypass the pooler.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/academy?schema=public

# === Auth secrets ==========================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
# Signs OAuth `state` and email/OTP action tokens.
TOKEN_PEPPER_SECRET=change-me-pepper-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Cookie domain (leave blank for host-only cookies), e.g. .example.com
COOKIE_DOMAIN=
# `lax` for same-site deployments, `none` (requires HTTPS) for cross-site.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# === OAuth providers (optional — provider is disabled when left blank) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# === Mail ==================================================================
# Transport: `console` (dev — logs the email), or `smtp`.
MAIL_TRANSPORT=console
MAIL_FROM="Academy <no-reply@academy.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# === Storage ===============================================================
# Driver: `local` (dev — writes to apps/api/uploads) or `s3` (S3-compatible incl. Supabase Storage).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
# Public base URL used to serve local uploads.
STORAGE_PUBLIC_URL=http://localhost:4000/uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=
MAX_UPLOAD_MB=25

# === Rate limiting =========================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# === Live feed =============================================================
# The whole site updates itself over one WebSocket per tab. Signed-in accounts
# always get one; these two govern anonymous visitors on the public pages.
#
# Off, the public site behaves exactly as it did before the feed existed — it
# renders, navigates and is correct as of its last load. Turn it off if traffic
# outgrows a single API instance: the in-process registry does not span them.
REALTIME_PUBLIC_ENABLED=true
# Ceiling on anonymous sockets, so a traffic spike cannot become unbounded
# memory. Past it, new visitors are simply refused the socket.
REALTIME_MAX_ANONYMOUS=2000

# === Seeding ===============================================================
# Credentials for the initial Super Admin created by `npm run db:seed`.
SEED_ADMIN_EMAIL=admin@academy.local
SEED_ADMIN_PASSWORD=Admin123!Change
SEED_ADMIN_NAME=Platform Owner

# === Web app (apps/web/.env.local) ========================================
# Server-side base URL the Next.js server uses to reach the API.
API_INTERNAL_URL=http://localhost:4000
# Browser-visible API base URL.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
