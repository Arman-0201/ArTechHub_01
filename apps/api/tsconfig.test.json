{
  // The build config deliberately excludes `tests/` so nothing from it can end
  // up in `dist`. That also left the suite unchecked: a test could reference a
  // renamed export and still be counted as passing because it never ran the
  // assertion. This config typechecks the suite without emitting anything.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
