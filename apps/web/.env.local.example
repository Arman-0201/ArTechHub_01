# Base URL the Next.js server uses to reach the API (server components, SSR).
API_INTERNAL_URL=http://localhost:4000
# Base URL the browser uses. Must be reachable from the client.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Canonical public origin of this site, used for SEO metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
